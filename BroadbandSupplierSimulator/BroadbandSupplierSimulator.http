@BroadbandSupplierSimulator_HostAddress = http://localhost:5135
# Docker (docker compose up --build) listens on http://localhost:8080 instead.

### Create product order (valid) - expect 202 Accepted
POST {{BroadbandSupplierSimulator_HostAddress}}/hubco/tmf/productOrderingManagement/v4/productOrder
APIGW-Tracking-Header: test-123
Content-Type: application/json

{
  "externalId": "EXT-1",
  "description": "test order",
  "productOrderItem": [
    {
      "id": "1",
      "action": "add",
      "product": {
        "productCharacteristic": [
          { "name": "speed", "value": "80" }
        ]
      }
    }
  ]
}

### Create product order (invalid: add item without productCharacteristic) - expect 400 Bad Request
POST {{BroadbandSupplierSimulator_HostAddress}}/hubco/tmf/productOrderingManagement/v4/productOrder
APIGW-Tracking-Header: test-123
Content-Type: application/json

{
  "productOrderItem": [
    {
      "id": "1",
      "action": "add"
    }
  ]
}

###

### Set simulation options (partial update) - expect 200 OK with the settings now in effect
POST {{BroadbandSupplierSimulator_HostAddress}}/simulatorOptions/SetOptions
Content-Type: application/json

{
  "messageGapMs": 2000,
  "stageReturnFailure": "CommittedByBTWwBC",
  "endpoints": {
    "CreateProductOrder": { "sendFailure": true, "responseDelayMs": 500 }
  }
}

### Set simulation options (invalid values) - expect 400 Bad Request
POST {{BroadbandSupplierSimulator_HostAddress}}/simulatorOptions/SetOptions
Content-Type: application/json

{
  "messageGapMs": -1,
  "sendUrl": "not a url",
  "endpoints": {
    "UnknownEndpoint": { "sendFailure": true }
  }
}

###
